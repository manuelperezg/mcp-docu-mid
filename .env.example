# =================================================================
# MCP-DOC-MID: Environment Configuration Guide
# =================================================================

# -----------------------------------------------------------------
# 1. Transport & Network
# -----------------------------------------------------------------
# Transport mode: stdio (for local IDE/Claude) | sse / http (for remote/docker/k8s)
TRANSPORT_MODE=stdio
PORT=3000
LOG_LEVEL=info

# -----------------------------------------------------------------
# 2. Enterprise Security & Authentication
# -----------------------------------------------------------------
# Enable/disable token authentication on HTTP endpoints (set true in production)
ENABLE_AUTH=true
# Secret API Key or Bearer Token required for /sse and /messages
MCP_API_KEY=your-secure-production-api-key-here
# Allowed CORS origins (* or comma-separated URLs like https://agent.company.com)
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------
# 3. Observability & Live Dashboard
# -----------------------------------------------------------------
# Basic Auth credentials to access the HTML metrics dashboard at GET /dashboard
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-this-password-in-production

# -----------------------------------------------------------------
# 4. Traffic Hardening & Rate Limiting
# -----------------------------------------------------------------
# Rate Limit window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum allowed requests per IP per window
RATE_LIMIT_MAX=1000

# -----------------------------------------------------------------
# 5. Persistence & Diagnostics
# -----------------------------------------------------------------
# Enable atomic disk persistence for accumulated metrics and activity log
STATS_STORAGE_ENABLED=true
STATS_STORAGE_PATH=data/stats.json

# -----------------------------------------------------------------
# 6. OpenAPI / Swagger Knowledge Base
# -----------------------------------------------------------------
# Relative or absolute path to the directory containing .json / .yml OpenAPI files
SWAGGERS_DIR=swaggers
