# Transport configuration: stdio | sse | http
TRANSPORT_MODE=stdio
PORT=3000
LOG_LEVEL=info

# Enterprise Security
MCP_API_KEY=default-mcp-secret-key
ENABLE_AUTH=true
ALLOWED_ORIGINS=*

# Dashboard Web Access
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Persistence
STATS_STORAGE_ENABLED=true
STATS_STORAGE_PATH=data/stats.json

# Swagger / OpenAPI Knowledge Base
SWAGGERS_DIR=swaggers
